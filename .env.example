# Fleet Copilot — bring your own LLM provider.
# Copy this file to .env and fill in ONE of the configurations below.
# The agent never sends telemetry identifiers anywhere except the LLM you configure.

# ── model ────────────────────────────────────────────────────────────────────
# Provider-qualified id (langchain format):
#   google_genai:gemini-2.0-flash        (Google Gemini)
#   anthropic:claude-sonnet-4-5          (Anthropic)
#   openai:gpt-4o                        (native OpenAI)
#   openai/gpt-6-luna                    (Nous Portal — slash form, see below)
FLEET_LLM_MODEL=google_genai:gemini-2.0-flash

# ── your key ─────────────────────────────────────────────────────────────────
# One generic name for every provider; it is routed to the right constructor
# parameter automatically (google_api_key / anthropic_api_key / api_key).
LLM_API_KEY=your-key-here

# ── optional: OpenAI-compatible endpoint ─────────────────────────────────────
# Set this to serve ANY model id through an OpenAI-compatible API:
#   Nous Portal:   https://inference-api.nousresearch.com/v1
#   OpenRouter:    https://openrouter.ai/api/v1
#   local vLLM:    http://localhost:8000/v1
# Leave empty for native providers (Google, Anthropic, OpenAI).
# A slash-form model id (openai/gpt-6-luna) WITHOUT this variable defaults to
# the Nous Portal endpoint.
# LLM_BASE_URL=https://inference-api.nousresearch.com/v1
